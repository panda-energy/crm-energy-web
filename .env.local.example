# ─────────────────────────────────────────────────────────────────────────────
# crm-energy-web — variables de entorno para desarrollo local
#
# Copia este archivo a `.env.local` y rellena con tus claves de dev.
# .env.local NUNCA se commitea (está en .gitignore).
#
# DevOps gestiona los valores reales en Doppler / Vercel para staging y prod.
# ─────────────────────────────────────────────────────────────────────────────

# ── Clerk (auth) ─────────────────────────────────────────────────────────────
# Obtener en https://dashboard.clerk.com → tu app dev → API Keys.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_replace_me
CLERK_SECRET_KEY=sk_test_replace_me

# Rutas Clerk (no cambiar salvo que el layout cambie).
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/

# ── Backend API ──────────────────────────────────────────────────────────────
# URL del backend FastAPI. Mientras backend no exista, se usa MSW (ver abajo).
# Producción/staging vivirá en Railway, NO en Vercel.
NEXT_PUBLIC_API_URL=http://localhost:3001

# ── Mock Service Worker ──────────────────────────────────────────────────────
# Activa el worker MSW en el navegador para interceptar /v1/* y devolver
# fixtures locales. Útil mientras el backend no esté disponible.
# Valores aceptados: "enabled" | cualquier otro valor lo desactiva.
NEXT_PUBLIC_API_MOCKING=enabled
