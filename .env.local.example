# ─────────────────────────────────────────────────────────────────────────────
# crm-energy-web — variables de entorno para desarrollo local
#
# Two-tier model:
#   1. SECRETS (Clerk) → Doppler project `crm-energy-web`, config `dev`.
#      Inyectados al runtime con `doppler run -- pnpm dev`.
#   2. LOCAL CONFIG (rutas, MSW toggle, backend URL) → este archivo `.env.local`
#      personal. Next.js lo auto-carga.
#
# Arranque local:
#   doppler run -- pnpm dev
#   doppler run -- pnpm test
# ─────────────────────────────────────────────────────────────────────────────

# ── Clerk (auth) → Doppler ───────────────────────────────────────────────────
# Estas viven en Doppler crm-energy-web/dev. No pegar aquí.
# Referencia de nombres que la app espera (comentadas):
# NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxx   # pública pero gestionada por Doppler
# CLERK_SECRET_KEY=sk_test_xxx                    # secreto

# Rutas Clerk (no cambiar salvo que el layout cambie).
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/dashboard

# Si las CLERK_* no están disponibles (sin `doppler run` y sin Doppler local),
# el middleware Clerk degrada a no-op y la app arranca con MSW (modo demo,
# todo público). Para activar auth real, arrancar con `doppler run`.

# ── Backend API ──────────────────────────────────────────────────────────────
# URL del backend FastAPI. Por defecto apunta al puerto típico de FastAPI dev
# (`uvicorn` en :8000). Producción/staging vivirá en Railway, NO en Vercel.
# El backend exige Bearer JWT de Clerk (claim `org_id` → tenant) y acepta
# además `X-Tenant-Id` redundante que el cliente inyecta automáticamente
# desde el `orgId` activo de Clerk (defensa en profundidad). No requiere
# variable de entorno separada para tenant.
NEXT_PUBLIC_API_URL=http://localhost:8000

# ── Mock Service Worker ──────────────────────────────────────────────────────
# Activa el worker MSW en el navegador para interceptar /v1/* y devolver
# fixtures locales. Útil mientras el backend no esté disponible localmente.
# Cuando MSW está activado, NEXT_PUBLIC_API_URL es irrelevante — todas las
# requests las intercepta el worker antes de salir a red.
# Valores aceptados: "enabled" | cualquier otro valor lo desactiva.
NEXT_PUBLIC_API_MOCKING=enabled

# ── Sentry (observability) → Doppler ──────────────────────────────────────
# Estas viven en Doppler crm-energy-web/dev. No pegar aquí.
# NEXT_PUBLIC_SENTRY_DSN=https://...@sentry.io/...  # public DSN
# SENTRY_AUTH_TOKEN=sntrys_...                        # source map upload
# SENTRY_ORG=panda-energy
# SENTRY_PROJECT=crm-energy-web
